{
    "manifest_version": 3,
    "name": "Auto Reload AADL",
    "version": "1.1.0",
    "default_locale": "fr",
    "description": "Automatically reloads https://aadl3inscription2024.dz/ until it loads.",
    "permissions":  [
        "notifications",
    "tabs",
    "webNavigation",
    "storage",
      "sidePanel",
      "browsingData"

  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "47d78fcb2ef59a8c0fc82a9beb98d773755e77d5@aadt.dz"
    }
  },
    "background": {
      "scripts": ["background.js"],
    "type": "module" 
    },
    "action": {
      
    "default_title": "Click to open panel"
    }, 
    "side_panel": {
      "default_path": "sidepanel.html"
     
    }   ,    
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      },
      
    "content_scripts": [
      {
        "matches": ["https://aadl3inscription2024.dz/*","http://localhost:8000/*"],
        "js": ["content.js"]
      }
    ]
  }
  